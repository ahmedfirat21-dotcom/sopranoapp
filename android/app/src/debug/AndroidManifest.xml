<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application android:usesCleartextTraffic="true" tools:targetApi="28" tools:ignore="GoogleAppIndexingWarning" tools:replace="android:usesCleartextTraffic">
        <!-- v255 (13 May 2026): Metro packager hostname APK'ya gömüldü; fiziksel
             telefonda dev client default localhost'a giderken bağlanamıyordu. Bu
             meta-data Sayesinde otomatik 192.168.1.3:8081'e yönlenir. -->
        <!-- v256→v257 fix: değer SADECE IP olmalı, port React Native default 8081 ekler.
             "192.168.1.3:8081" parse edilemediği için localhost'a düşüyordu. -->
        <meta-data android:name="com.facebook.react.devsupport.PACKAGER_HOSTNAME" android:value="192.168.1.3" />
    </application>
</manifest>
